# Server
PORT=3000

# Mongo
MONGODB_URI= 

# Gemini
GEMINI_API_KEY= 
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_RETRIES=3
GEMINI_MIN_DELAY_MS=1200


# Feeds (comma-separated)
RSS_FEED_URLS=https://news.ycombinator.com/rss,https://techcrunch.com/feed/,https://www.wired.com/feed/rss,https://www.theverge.com/rss/index.xml,https://api.quantamagazine.org/feed/,https://www.sciencedaily.com/rss/top/science.xml,https://www.nature.com/nature.rss,https://www.nasa.gov/rss/dyn/breaking_news.rss,https://aeon.co/feed.rss,https://en.wikipedia.org/w/api.php?action=featuredfeed&feed=featured&feedformat=atom,https://plato.stanford.edu/rss/sep.xml,https://www.aldaily.com/feed/,https://dailynous.com/feed/,https://www.economist.com/the-world-this-week/rss.xml,https://freakonomics.com/feed/,https://www.ft.com/?format=rss,https://www.openculture.com/feed,https://www.psychologytoday.com/us/front/feed,https://feeds.npr.org/1028/rss.xml,https://digest.bps.org.uk/feed/,https://www.who.int/rss-feeds/news-english.xml,http://feeds.bbci.co.uk/news/world/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/World.xml,https://www.aljazeera.com/xml/rss/all.xml
# Job scheduling
FETCH_CRON=0 0 * * *
RUN_ON_STARTUP=true
MAX_ITEMS_PER_FEED=10
HTTP_TIMEOUT_MS=20000
